# ============================================================================
# ColdChain Monitor - Environment Variables
# ============================================================================

# Supabase Public Configuration (Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Service Role Key (Keep Private! Never expose to browser)
# Used for backend API validation and ESP32 ingestion
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Optional default device token fallback
DEFAULT_DEVICE_TOKEN=coldchain_secret_device_token_2026

# Optional additional dashboard operator provisioned by seed.js
ADDITIONAL_OPERATOR_EMAIL=Ayushbthaokar@gmail.com
ADDITIONAL_OPERATOR_PASSWORD=replace-with-a-strong-password
